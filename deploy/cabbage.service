[Unit]
Description=cabbage-coin (Japanese cabbage price map)
After=network-online.target
Wants=network-online.target

[Service]
User=cabbage
Group=cabbage
ExecStart=/opt/cabbage/cabbage -addr 127.0.0.1:8080 -data /var/lib/cabbage
Restart=always
RestartSec=5
StateDirectory=cabbage
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
